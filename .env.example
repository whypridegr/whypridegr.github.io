# PostHog analytics. The key is a PUBLIC project key (phc_…) — it ships in the
# browser bundle by design, so it's not a secret. Kept in env so US↔EU or key
# rotation is a config change. Set the same two vars in Vercel (all environments).
PUBLIC_POSTHOG_KEY=phc_your_project_key_here
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
