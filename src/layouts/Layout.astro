---
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import ConsentBanner from "../components/site/ConsentBanner.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** One or more schema.org objects, emitted as JSON-LD in <head>. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  structuredData,
} = Astro.props;

const jsonLdBlocks = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

// Escape "<" so a stray "</script>" inside content can't break out of the tag.
const toJsonLd = (block: Record<string, unknown>) =>
  JSON.stringify(block).replace(/</g, "\\u003c");

const ogImage =
  "https://pub-bb2e103a32db4e198524a2e9ed8f35b4.r2.dev/39ffc52f-1eac-44b5-a11f-a5eb989f6e67/id-preview-6fdca055--8639a017-f487-447b-9f11-33ee27460728.lovable.app-1779995919950.png";
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="oAZHLT3YLDGdADrlwe4seOt2wrBU-j_LJObjUhCK0wQ" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#3b6fd6" />
    <title>{title}</title>

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={toJsonLd(block)} />
      ))
    }

    {/* No-flash theme: light by default, dark only if the device asks for it.
        Device-driven (no stored override), runs before paint. */}
    <script is:inline>
      (function () {
        try {
          var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var el = document.documentElement;
          el.classList.toggle("dark", dark);
          el.style.colorScheme = dark ? "dark" : "light";
        } catch (e) {}
      })();
    </script>

    {/* Analytics: boots PostHog + section/interaction/outbound trackers.
        Processed by Astro (bundled, deduped) so the npm import resolves. */}
    <script src="../lib/analytics-init.ts"></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
