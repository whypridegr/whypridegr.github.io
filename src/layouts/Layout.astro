---
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import ConsentBanner from "../components/site/ConsentBanner.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** One or more schema.org objects, emitted as JSON-LD in <head>. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  structuredData,
} = Astro.props;

const jsonLdBlocks = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

// Escape "<" so a stray "</script>" inside content can't break out of the tag.
const toJsonLd = (block: Record<string, unknown>) =>
  JSON.stringify(block).replace(/</g, "\\u003c");

// Self-hosted social share image (1200×630-class, lives in /public). Same
// artwork we shipped before, now served from our own origin so the preview
// never breaks if the upstream bucket disappears.
const ogImage = new URL("/og-image.png", Astro.site).href;
const ogImageAlt = "WhyPride.gr: Γιατί υπάρχει Pride;";

// Canonical + og:url. Build output is `directory` format (/about/ URLs), so
// normalise to a trailing slash to match the sitemap and avoid duplicate
// canonicals for /foo vs /foo/.
const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site).href;
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="oAZHLT3YLDGdADrlwe4seOt2wrBU-j_LJObjUhCK0wQ" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#3b6fd6" />
    <title>{title}</title>

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={toJsonLd(block)} />
      ))
    }

    {/* No-flash theme: light by default, dark only if the device asks for it.
        Device-driven (no stored override), runs before paint. */}
    <script is:inline>
      (function () {
        try {
          var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var el = document.documentElement;
          el.classList.toggle("dark", dark);
          el.style.colorScheme = dark ? "dark" : "light";
        } catch (e) {}
      })();
    </script>

    {/* Analytics: boots PostHog + section/interaction/outbound trackers.
        Processed by Astro (bundled, deduped) so the npm import resolves. */}
    <script src="../lib/analytics-init.ts"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Μετάβαση στο περιεχόμενο</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
