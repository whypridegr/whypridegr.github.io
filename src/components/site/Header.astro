---
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/", label: "Αρχική" },
  { href: "/quiz", label: "Πόσο ally είσαι;" },
  { href: "/#erotiseis", label: "Συχνές ερωτήσεις" },
  { href: "/glossary", label: "Γλωσσάρι" },
  { href: "/sources", label: "Πηγές" },
  { href: "/about", label: "Σχετικά" },
];
---

{/* No bar. Two floating sticky controls that tuck away on scroll-down. */}
<div id="wp-nav" class="pointer-events-none">
  <button
    id="wp-menu-btn"
    type="button"
    aria-expanded="false"
    aria-controls="wp-menu"
    aria-label="Άνοιγμα μενού πλοήγησης"
    class="pointer-events-auto fixed left-4 top-4 z-50 inline-flex items-center justify-center p-2 transition-all duration-300"
  >
    <span id="wp-bar" class="block h-1.5 w-7 rounded-full pride-rule"></span>
  </button>

  <nav
    id="wp-menu"
    aria-label="Πλοήγηση ιστότοπου"
    hidden
    class="pointer-events-auto fixed left-3 top-14 z-50 w-56 rounded-xl border border-border bg-card p-2 shadow-xl"
  >
    <div class="pride-rule-fade mb-2 h-px w-full"></div>
    {
      links.map((l) => (
        <a
          href={l.href}
          class="block rounded-lg px-3 py-2 text-sm text-foreground transition-colors hover:bg-secondary hover:text-accent"
        >
          {l.label}
        </a>
      ))
    }
  </nav>

  {/* "What is this?" — a quiet entry to the background material (history +
      glossary), the way empathy-prompts keeps its context one tap away. */}
  <div
    id="wp-info-wrap"
    class="pointer-events-auto fixed right-12 top-4 z-50 transition-all duration-300"
  >
    <button
      id="wp-info-btn"
      type="button"
      aria-expanded="false"
      aria-controls="wp-info-menu"
      aria-label="Υπόβαθρο: ιστορική αναδρομή και γλωσσάρι"
      class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-ink"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 16v-4M12 8h.01"></path>
      </svg>
    </button>

    <nav
      id="wp-info-menu"
      aria-label="Υπόβαθρο"
      hidden
      class="absolute right-0 top-12 w-56 rounded-xl border border-border bg-card p-2 shadow-xl"
    >
      <a
        href="/#istoria"
        class="block rounded-lg px-3 py-2 text-sm text-foreground transition-colors hover:bg-secondary hover:text-accent"
      >
        Ιστορική αναδρομή
      </a>
      <a
        href="/glossary"
        class="block rounded-lg px-3 py-2 text-sm text-foreground transition-colors hover:bg-secondary hover:text-accent"
      >
        Γλωσσάρι
      </a>
    </nav>
  </div>

  <div
    id="wp-theme-wrap"
    class="pointer-events-auto fixed right-3 top-4 z-50 transition-all duration-300"
  >
    <ThemeToggle />
  </div>
</div>

<style>
  /* Scrolling down: both controls lift away entirely, so nothing sits over the
     reading column. They return on scroll-up. */
  #wp-menu-btn.wp-condensed {
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
  }
  #wp-theme-wrap.wp-collapsed,
  #wp-info-wrap.wp-collapsed {
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
  }
</style>

<script>
  const btn = document.getElementById("wp-menu-btn");
  const menu = document.getElementById("wp-menu");
  const themeWrap = document.getElementById("wp-theme-wrap");
  const infoWrap = document.getElementById("wp-info-wrap");
  const infoBtn = document.getElementById("wp-info-btn");
  const infoMenu = document.getElementById("wp-info-menu");

  // "What is this?" popover — same open/close/escape/outside-click behaviour as
  // the main menu, kept self-contained so the two never fight over focus.
  let infoOpen = false;
  if (infoBtn && infoMenu) {
    const setInfoOpen = (next: boolean) => {
      infoOpen = next;
      infoMenu.hidden = !next;
      infoBtn.setAttribute("aria-expanded", String(next));
      if (next) {
        infoWrap?.classList.remove("wp-collapsed");
        infoMenu.querySelector<HTMLElement>("a")?.focus();
      }
    };

    infoBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      setInfoOpen(!infoOpen);
    });

    document.addEventListener("click", (e) => {
      if (!infoOpen) return;
      const t = e.target as Node;
      const el = t as HTMLElement;
      if (
        (!infoMenu.contains(t) && !infoBtn.contains(t)) ||
        (infoMenu.contains(t) && el.closest?.("a"))
      ) {
        setInfoOpen(false);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (infoOpen && e.key === "Escape") {
        setInfoOpen(false);
        infoBtn.focus();
      }
    });
  }

  if (btn && menu) {
    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      menu.hidden = !next;
      btn.setAttribute("aria-expanded", String(next));
      if (next) {
        // Keep both controls in their normal spot while the menu is open.
        btn.classList.remove("wp-condensed");
        themeWrap?.classList.remove("wp-collapsed");
        menu.querySelector<HTMLElement>("a")?.focus();
      }
    };

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!open);
    });

    document.addEventListener("click", (e) => {
      if (!open) return;
      const t = e.target as Node;
      // Close on outside click, or when a link inside the menu is chosen
      // (same-page hash links don't reload, so close them explicitly).
      const el = t as HTMLElement;
      if (
        (!menu.contains(t) && !btn.contains(t)) ||
        (menu.contains(t) && el.closest?.("a"))
      ) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (e) => {
      if (open && e.key === "Escape") {
        setOpen(false);
        btn.focus();
      }
    });

    // Collapse on scroll-down, restore on scroll-up (never while menu is open).
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        if (!open) {
          const condense = y > lastY && y > 120;
          btn.classList.toggle("wp-condensed", condense);
          themeWrap?.classList.toggle("wp-collapsed", condense);
          // Keep the info popover anchor put while it's open.
          if (!infoOpen) infoWrap?.classList.toggle("wp-collapsed", condense);
        }
        lastY = y;
        ticking = false;
      });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
