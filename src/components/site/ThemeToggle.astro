---
// Dark/light toggle. Initial theme is set pre-paint by the inline script in Layout.astro.
---

<button
  id="wp-theme-toggle"
  type="button"
  class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:text-ink"
  aria-label="Εναλλαγή φωτεινού / σκούρου θέματος"
  title="Εναλλαγή θέματος"
>
  <svg class="wp-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="wp-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  :global(html.dark) .wp-moon { display: none; }
  :global(html:not(.dark)) .wp-sun { display: none; }
</style>

<script>
  const btn = document.getElementById("wp-theme-toggle");
  const isDark = () => document.documentElement.classList.contains("dark");

  const apply = (theme: "light" | "dark") => {
    const dark = theme === "dark";
    const el = document.documentElement;
    el.classList.toggle("dark", dark);
    el.style.colorScheme = dark ? "dark" : "light";
    btn?.setAttribute("aria-pressed", String(dark));
    try {
      localStorage.setItem("wp-theme", theme);
    } catch (e) {
      /* storage unavailable */
    }
  };

  btn?.setAttribute("aria-pressed", String(isDark()));
  btn?.addEventListener("click", () => apply(isDark() ? "light" : "dark"));
</script>
